		"foreground": "#2A1A30",
		"disabledForeground": "#9884A1",
		"selection.background": "#E0C8E88C",
		"errorForeground": "#E04058",
		"editor.background": "#FAF6FA",
		"editor.foreground": "#2A1A30",
		"editorLineNumber.foreground": "#A37FAE",
		"editorLineNumber.activeForeground": "#00868C",
		"editor.lineHighlightBackground": "#F0E8F51F",
		"editor.selectionBackground": "#E0C8E88C",
		"editor.inactiveSelectionBackground": "#E0C8E859",
		"editorCursor.foreground": "#B050D0",
		"editor.findMatchBackground": "#BA57A724",
		"editor.findMatchHighlightBackground": "#BA57A714",
		"editor.findMatchBorder": "#E04058",
		"editor.wordHighlightBackground": "#B050D01A",
		"editor.wordHighlightStrongBackground": "#E0C8E840",
		"merge.currentHeaderBackground": "#01844F4D",
		"merge.currentContentBackground": "#01844F26",
		"merge.incomingHeaderBackground": "#8050C84D",
		"merge.incomingContentBackground": "#8050C826",
		"merge.commonHeaderBackground": "#9884A14D",
		"merge.commonContentBackground": "#9884A126",
		"editorGutter.background": "#FAF6FA",
		"editorGutter.modifiedBackground": "#90720680",
		"editorGutter.addedBackground": "#01844F80",
		"editorGutter.deletedBackground": "#E0405880",
		"editorWhitespace.foreground": "#9884A140",
		"editorIndentGuide.background1": "#E8D8F050",
		"editorIndentGuide.activeBackground1": "#9884A180",
		"editorError.foreground": "#E04058",
		"editorWarning.foreground": "#907206",
		"editorInfo.foreground": "#8050C8",
		"editorHint.foreground": "#6070C8",
		"activityBar.background": "#F5F0F5",
		"activityBar.foreground": "#63536F",
		"activityBar.inactiveForeground": "#9884A1",
		"activityBar.border": "#E8D8F0",
		"activityBarBadge.background": "#B050D0",
		"activityBarBadge.foreground": "#FAF6FA",
		"sideBar.background": "#F5F0F5",
		"sideBar.foreground": "#2A1A30",
		"sideBar.border": "#E8D8F0",
		"sideBarSectionHeader.background": "#E0C8E8",
		"sideBarSectionHeader.foreground": "#63536F",
		"tab.activeBackground": "#FAF6FA",
		"tab.inactiveBackground": "#F5F0F5",
		"tab.activeForeground": "#2A1A30",
		"tab.inactiveForeground": "#9884A1",
		"tab.border": "#E8D8F0",
		"tab.activeBorderTop": "#B050D0",
		"editorGroupHeader.tabsBackground": "#F5F0F5",
		"editorGroupHeader.tabsBorder": "#E8D8F0",
		"titleBar.activeBackground": "#F5F0F5",
		"titleBar.activeForeground": "#2A1A30",
		"titleBar.inactiveBackground": "#F0E8F0",
		"titleBar.inactiveForeground": "#9884A1",
		"titleBar.border": "#E8D8F0",
		"statusBar.background": "#F0E8F0",
		"statusBar.foreground": "#63536F",
		"panel.background": "#F5F0F5",
		"panel.border": "#E8D8F0",
		"panelTitle.activeForeground": "#2A1A30",
		"panelTitle.inactiveForeground": "#9884A1",
		"scrollbarSlider.background": "#9884A14C",
		"scrollbarSlider.hoverBackground": "#9884A180",
		"scrollbarSlider.activeBackground": "#63536FB0",
		"terminal.background": "#FAF6FA",
		"terminal.foreground": "#2A1A30",
		"terminal.ansiBlack": "#2A1A30",
		"terminal.ansiRed": "#E04058",
		"terminal.ansiGreen": "#01844F",
		"terminal.ansiYellow": "#907206",
		"terminal.ansiBlue": "#8050C8",
		"terminal.ansiMagenta": "#D04080",
		"terminal.ansiCyan": "#00868C",
		"terminal.ansiWhite": "#63536F",
		"terminal.ansiBrightBlack": "#9884A1",
		"terminal.ansiBrightRed": "#C62039",
		"terminal.ansiBrightGreen": "#016A3F",
		"terminal.ansiBrightYellow": "#735B05",
		"terminal.ansiBrightBlue": "#6436AA",
		"terminal.ansiBrightMagenta": "#AF2B65",
		"terminal.ansiBrightCyan": "#006B70",
		"terminal.ansiBrightWhite": "#836E93",
		"input.background": "#F0E8F5",
		"input.foreground": "#2A1A30",
		"input.border": "#E8D8F0",
		"input.placeholderForeground": "#9884A1",
		"button.background": "#B050D0",
		"button.foreground": "#FAF6FA",
		"button.hoverBackground": "#B050D0DD",
		"badge.foreground": "#FAF6FA",
		"badge.background": "#B050D0",
		"progressBar.background": "#B050D0",
		"textLink.foreground": "#1278B8",
		"textLink.activeForeground": "#1278B8",
		"minimap.findMatchHighlight": "#BA57A7",
		"minimap.selectionHighlight": "#E0C8E88C",
		"editorBracketHighlight.foreground1": "#B050D0",
		"editorBracketHighlight.foreground2": "#00868C",
		"editorBracketHighlight.foreground3": "#BA57A7",
		"editorBracketHighlight.foreground4": "#1278B8",
		"editorBracketHighlight.foreground5": "#C65100",
		"editorBracketHighlight.foreground6": "#01844F"
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"comment.block",
				"comment.line",
				"comment.line.double-slash",
				"comment.line.number-sign",
				"comment.triple-slash"
			],
			"settings": {
				"foreground": "#A37FAE",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted.double",
				"string.quoted.single",
				"string.quoted.triple",
				"string.unquoted",
				"string.regexp"
			],
			"settings": {
				"foreground": "#01844F"
			}
		},
		{
			"name": "String Escape",
			"scope": [
				"constant.character.escape",
				"constant.character.escape.backslash"
			],
			"settings": {
				"foreground": "#01844F"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.numeric.float",
				"constant.numeric.integer",
				"constant.numeric.hex",
				"constant.numeric.octal",
				"constant.numeric.binary"
			],
			"settings": {
				"foreground": "#C65100"
			}
		},
		{
			"name": "Boolean",
			"scope": [
				"constant.language.boolean",
				"constant.language.true",
				"constant.language.false"
			],
			"settings": {
				"foreground": "#C65100"
			}
		},
		{
			"name": "Constant",
			"scope": [
				"constant",
				"constant.language",
				"constant.language.null",
				"constant.language.undefined",
				"constant.language.nan"
			],
			"settings": {
				"foreground": "#C65100"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.control.import",
				"keyword.control.from",
				"keyword.control.export",
				"keyword.control.return",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop"
			],
			"settings": {
				"foreground": "#BA57A7"
			}
		},
		{
			"name": "Keyword Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.comparison",
				"keyword.operator.logical",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#B04068"
			}
		},
		{
			"name": "Storage Type",
			"scope": [
				"storage.type",
				"storage.type.class",
				"storage.type.enum",
				"storage.type.interface",
				"storage.type.struct",
				"storage.type.function",
				"storage.type.method"
			],
			"settings": {
				"foreground": "#C65100"
			}
		},
		{
			"name": "Storage Modifier",
			"scope": [
				"storage.modifier",
				"storage.modifier.async",
				"storage.modifier.const",
				"storage.modifier.static",
				"storage.modifier.abstract",
				"storage.modifier.readonly",
				"storage.modifier.mutable",
				"storage.modifier.private",
				"storage.modifier.public",
				"storage.modifier.protected"
			],
			"settings": {
				"foreground": "#B050D0"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#8050C8"
			}
		},
		{
			"name": "Method",
			"scope": ["entity.name.function.member", "meta.method"],
			"settings": {
				"foreground": "#1278B8"
			}
		},
		{
			"name": "Constructor",
			"scope": ["entity.name.function.constructor", "entity.name.type.class"],
			"settings": {
				"foreground": "#8050C8"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.other",
				"variable.other.member",
				"variable.other.object",
				"variable.other.constant",
				"meta.var"
			],
			"settings": {
				"foreground": "#2A1A30"
			}
		},
		{
			"name": "Parameter",
			"scope": ["variable.parameter", "entity.name.variable.parameter"],
			"settings": {
				"foreground": "#B04068"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"entity.name.variable.member",
				"meta.property"
			],
			"settings": {
				"foreground": "#00868C"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute",
				"meta.attribute",
				"decorator",
				"meta.decorator"
			],
			"settings": {
				"foreground": "#6070C8"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.type.class",
				"entity.name.type.enum",
				"entity.name.type.interface",
				"entity.name.type.struct",
				"support.type",
				"support.class",
				"entity.name.type.alias"
			],
			"settings": {
				"foreground": "#C65100"
			}
		},
		{
			"name": "Namespace",
			"scope": [
				"entity.name.namespace",
				"entity.name.module",
				"entity.name.package"
			],
			"settings": {
				"foreground": "#BA57A7"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"entity.name.tag.html",
				"entity.name.tag.xml",
				"entity.name.tag.jsx"
			],
			"settings": {
				"foreground": "#01844F"
			}
		},
		{
			"name": "Attribute Name (HTML/JSX)",
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html",
				"entity.other.attribute-name.xml",
				"entity.other.attribute-name.jsx",
				"entity.other.attribute-name.css"
			],
			"settings": {
				"foreground": "#907206"
			}
		},
		{
			"name": "Selector",
			"scope": ["entity.name.selector", "meta.selector"],
			"settings": {
				"foreground": "#907206"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"punctuation.terminator",
				"punctuation.separator",
				"punctuation.separator.colon",
				"punctuation.separator.comma",
				"punctuation.separator.dot",
				"punctuation.separator.arrow",
				"punctuation.separator.key-value",
				"punctuation.section"
			],
			"settings": {
				"foreground": "#2A1A30"
			}
		},
		{
			"name": "Bracket",
			"scope": [
				"punctuation.section.brackets",
				"punctuation.section.parens",
				"punctuation.section.braces",
				"meta.brace",
				"punctuation.definition.brackets",
				"punctuation.definition.parens",
				"punctuation.definition.braces"
			],
			"settings": {
				"foreground": "#2A1A30"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.comparison",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#B04068"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"keyword.control.directive",
				"meta.preprocessor",
				"meta.preprocessor.directive",
				"keyword.control.preprocessor"
			],
			"settings": {
				"foreground": "#BA57A7"
			}
		},
		{
			"name": "URL/Link",
			"scope": [
				"string.other.link",
				"markup.underline.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#8050C8"
			}
		},
		{
			"name": "Heading",
			"scope": ["markup.heading", "entity.name.section", "heading"],
			"settings": {
				"foreground": "#907206"
			}
		},
		{
			"name": "Bold",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#907206"
			}
		},
		{
			"name": "Italic",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#8050C8"
			}
		},
		{
			"name": "Deprecated",
			"scope": ["markup.deleted", "markup.strikethrough", "meta.deprecated"],
			"settings": {
				"foreground": "#E04058"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
			"settings": {
				"foreground": "#E04058"
			}
		}
	]
}
