{
	"name": "Synthpunk Pastel Light",
	"type": "light",
	"colors": {
		"focusBorder": "#8A51C8",
		"foreground": "#2E1A24",
		"disabledForeground": "#997A8A",
		"selection.background": "#D4B8C88C",
		"errorForeground": "#DB1836",
		"editor.background": "#FFF8F5",
		"editor.foreground": "#2E1A24",
		"editorLineNumber.foreground": "#A27690",
		"editorLineNumber.activeForeground": "#03808E",
		"editor.lineHighlightBackground": "#F0DEE81F",
		"editor.selectionBackground": "#D4B8C88C",
		"editor.inactiveSelectionBackground": "#D4B8C859",
		"editorCursor.foreground": "#8A51C8",
		"editor.findMatchBackground": "#BB497024",
		"editor.findMatchHighlightBackground": "#BB497014",
		"editor.findMatchBorder": "#DB1836",
		"editor.wordHighlightBackground": "#8A51C81A",
		"editor.wordHighlightStrongBackground": "#D4B8C840",
		"merge.currentHeaderBackground": "#037E554D",
		"merge.currentContentBackground": "#037E5526",
		"merge.incomingHeaderBackground": "#4556D24D",
		"merge.incomingContentBackground": "#4556D226",
		"merge.commonHeaderBackground": "#997A8A4D",
		"merge.commonContentBackground": "#997A8A26",
		"editorGutter.background": "#FFF8F5",
		"editorGutter.modifiedBackground": "#8F6C0280",
		"editorGutter.addedBackground": "#037E5580",
		"editorGutter.deletedBackground": "#DB183680",
		"editorWhitespace.foreground": "#997A8A40",
		"editorIndentGuide.background1": "#E4CCD850",
		"editorIndentGuide.activeBackground1": "#997A8A80",
		"editorError.foreground": "#DB1836",
		"editorWarning.foreground": "#8F6C02",
		"editorInfo.foreground": "#4556D2",
		"editorHint.foreground": "#546D86",
		"activityBar.background": "#FFF0EB",
		"activityBar.foreground": "#614755",
		"activityBar.inactiveForeground": "#997A8A",
		"activityBar.border": "#E4CCD8",
		"activityBarBadge.background": "#8A51C8",
		"activityBarBadge.foreground": "#FFF8F5",
		"sideBar.background": "#FFF0EB",
		"sideBar.foreground": "#2E1A24",
		"sideBar.border": "#E4CCD8",
		"sideBarSectionHeader.background": "#D4B8C8",
		"sideBarSectionHeader.foreground": "#614755",
		"tab.activeBackground": "#FFF8F5",
		"tab.inactiveBackground": "#FFF0EB",
		"tab.activeForeground": "#2E1A24",
		"tab.inactiveForeground": "#997A8A",
		"tab.border": "#E4CCD8",
		"tab.activeBorderTop": "#8A51C8",
		"editorGroupHeader.tabsBackground": "#FFF0EB",
		"editorGroupHeader.tabsBorder": "#E4CCD8",
		"titleBar.activeBackground": "#FFF0EB",
		"titleBar.activeForeground": "#2E1A24",
		"titleBar.inactiveBackground": "#FFE8E0",
		"titleBar.inactiveForeground": "#997A8A",
		"titleBar.border": "#E4CCD8",
		"statusBar.background": "#FFE8E0",
		"statusBar.foreground": "#614755",
		"panel.background": "#FFF0EB",
		"panel.border": "#E4CCD8",
		"panelTitle.activeForeground": "#2E1A24",
		"panelTitle.inactiveForeground": "#997A8A",
		"scrollbarSlider.background": "#997A8A4C",
		"scrollbarSlider.hoverBackground": "#997A8A80",
		"scrollbarSlider.activeBackground": "#614755B0",
		"terminal.background": "#FFF8F5",
		"terminal.foreground": "#2E1A24",
		"terminal.ansiBlack": "#2E1A24",
		"terminal.ansiRed": "#DB1836",
		"terminal.ansiGreen": "#037E55",
		"terminal.ansiYellow": "#8F6C02",
		"terminal.ansiBlue": "#4556D2",
		"terminal.ansiMagenta": "#BB218A",
		"terminal.ansiCyan": "#03808E",
		"terminal.ansiWhite": "#614755",
		"terminal.ansiBrightBlack": "#997A8A",
		"terminal.ansiBrightRed": "#AF132B",
		"terminal.ansiBrightGreen": "#026544",
		"terminal.ansiBrightYellow": "#725602",
		"terminal.ansiBrightBlue": "#2B3CB4",
		"terminal.ansiBrightMagenta": "#961A6E",
		"terminal.ansiBrightCyan": "#026672",
		"terminal.ansiBrightWhite": "#886478",
		"input.background": "#F0DEE8",
		"input.foreground": "#2E1A24",
		"input.border": "#E4CCD8",
		"input.placeholderForeground": "#997A8A",
		"button.background": "#8A51C8",
		"button.foreground": "#FFF8F5",
		"button.hoverBackground": "#8A51C8DD",
		"badge.foreground": "#FFF8F5",
		"badge.background": "#8A51C8",
		"progressBar.background": "#8A51C8",
		"textLink.foreground": "#026BAA",
		"textLink.activeForeground": "#026BAA",
		"minimap.findMatchHighlight": "#BB4970",
		"minimap.selectionHighlight": "#D4B8C88C",
		"editorBracketHighlight.foreground1": "#8A51C8",
		"editorBracketHighlight.foreground2": "#03808E",
		"editorBracketHighlight.foreground3": "#BB4970",
		"editorBracketHighlight.foreground4": "#026BAA",
		"editorBracketHighlight.foreground5": "#BC4D04",
		"editorBracketHighlight.foreground6": "#037E55"
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"comment.block",
				"comment.line",
				"comment.line.double-slash",
				"comment.line.number-sign",
				"comment.triple-slash"
			],
			"settings": {
				"foreground": "#A27690",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted.double",
				"string.quoted.single",
				"string.quoted.triple",
				"string.unquoted",
				"string.regexp"
			],
			"settings": {
				"foreground": "#037E55"
			}
		},
		{
			"name": "String Escape",
			"scope": [
				"constant.character.escape",
				"constant.character.escape.backslash"
			],
			"settings": {
				"foreground": "#037E55"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.numeric.float",
				"constant.numeric.integer",
				"constant.numeric.hex",
				"constant.numeric.octal",
				"constant.numeric.binary"
			],
			"settings": {
				"foreground": "#BC4D04"
			}
		},
		{
			"name": "Boolean",
			"scope": [
				"constant.language.boolean",
				"constant.language.true",
				"constant.language.false"
			],
			"settings": {
				"foreground": "#BC4D04"
			}
		},
		{
			"name": "Constant",
			"scope": [
				"constant",
				"constant.language",
				"constant.language.null",
				"constant.language.undefined",
				"constant.language.nan"
			],
			"settings": {
				"foreground": "#BC4D04"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.control.import",
				"keyword.control.from",
				"keyword.control.export",
				"keyword.control.return",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop"
			],
			"settings": {
				"foreground": "#BB4970"
			}
		},
		{
			"name": "Keyword Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.comparison",
				"keyword.operator.logical",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#7F3E4C"
			}
		},
		{
			"name": "Storage Type",
			"scope": [
				"storage.type",
				"storage.type.class",
				"storage.type.enum",
				"storage.type.interface",
				"storage.type.struct",
				"storage.type.function",
				"storage.type.method"
			],
			"settings": {
				"foreground": "#BC4D04"
			}
		},
		{
			"name": "Storage Modifier",
			"scope": [
				"storage.modifier",
				"storage.modifier.async",
				"storage.modifier.const",
				"storage.modifier.static",
				"storage.modifier.abstract",
				"storage.modifier.readonly",
				"storage.modifier.mutable",
				"storage.modifier.private",
				"storage.modifier.public",
				"storage.modifier.protected"
			],
			"settings": {
				"foreground": "#8A51C8"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#4556D2"
			}
		},
		{
			"name": "Method",
			"scope": ["entity.name.function.member", "meta.method"],
			"settings": {
				"foreground": "#026BAA"
			}
		},
		{
			"name": "Constructor",
			"scope": ["entity.name.function.constructor", "entity.name.type.class"],
			"settings": {
				"foreground": "#4556D2"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.other",
				"variable.other.member",
				"variable.other.object",
				"variable.other.constant",
				"meta.var"
			],
			"settings": {
				"foreground": "#2E1A24"
			}
		},
		{
			"name": "Parameter",
			"scope": ["variable.parameter", "entity.name.variable.parameter"],
			"settings": {
				"foreground": "#7F3E4C"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"entity.name.variable.member",
				"meta.property"
			],
			"settings": {
				"foreground": "#03808E"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute",
				"meta.attribute",
				"decorator",
				"meta.decorator"
			],
			"settings": {
				"foreground": "#546D86"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.type.class",
				"entity.name.type.enum",
				"entity.name.type.interface",
				"entity.name.type.struct",
				"support.type",
				"support.class",
				"entity.name.type.alias"
			],
			"settings": {
				"foreground": "#BC4D04"
			}
		},
		{
			"name": "Namespace",
			"scope": [
				"entity.name.namespace",
				"entity.name.module",
				"entity.name.package"
			],
			"settings": {
				"foreground": "#BB4970"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"entity.name.tag.html",
				"entity.name.tag.xml",
				"entity.name.tag.jsx"
			],
			"settings": {
				"foreground": "#037E55"
			}
		},
		{
			"name": "Attribute Name (HTML/JSX)",
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html",
				"entity.other.attribute-name.xml",
				"entity.other.attribute-name.jsx",
				"entity.other.attribute-name.css"
			],
			"settings": {
				"foreground": "#8F6C02"
			}
		},
		{
			"name": "Selector",
			"scope": ["entity.name.selector", "meta.selector"],
			"settings": {
				"foreground": "#8F6C02"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"punctuation.terminator",
				"punctuation.separator",
				"punctuation.separator.colon",
				"punctuation.separator.comma",
				"punctuation.separator.dot",
				"punctuation.separator.arrow",
				"punctuation.separator.key-value",
				"punctuation.section"
			],
			"settings": {
				"foreground": "#2E1A24"
			}
		},
		{
			"name": "Bracket",
			"scope": [
				"punctuation.section.brackets",
				"punctuation.section.parens",
				"punctuation.section.braces",
				"meta.brace",
				"punctuation.definition.brackets",
				"punctuation.definition.parens",
				"punctuation.definition.braces"
			],
			"settings": {
				"foreground": "#2E1A24"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.comparison",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#7F3E4C"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"keyword.control.directive",
				"meta.preprocessor",
				"meta.preprocessor.directive",
				"keyword.control.preprocessor"
			],
			"settings": {
				"foreground": "#BB4970"
			}
		},
		{
			"name": "URL/Link",
			"scope": [
				"string.other.link",
				"markup.underline.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#4556D2"
			}
		},
		{
			"name": "Heading",
			"scope": ["markup.heading", "entity.name.section", "heading"],
			"settings": {
				"foreground": "#8F6C02"
			}
		},
		{
			"name": "Bold",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#8F6C02"
			}
		},
		{
			"name": "Italic",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#4556D2"
			}
		},
		{
			"name": "Deprecated",
			"scope": ["markup.deleted", "markup.strikethrough", "meta.deprecated"],
			"settings": {
				"foreground": "#DB1836"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
			"settings": {
				"foreground": "#DB1836"
			}
		}
	]
}
